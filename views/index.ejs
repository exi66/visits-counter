<!DOCTYPE html>
<html>
  <head>
    <style>
    table, th, td {
      border: 1px solid black;
    }

    table {
      border-collapse: collapse;
      width: auto;
    }

    th, td {
      padding: 8px;
      text-align: left;
    }
    </style>    
  </head>
  <body>
    <table>
      <tr>
        <th>url</th>
        <th>visits</th>
      </tr>
        <% data.forEach(function(result){ %>
            <tr>
              <td><%= result.url %></td>
              <td style="text-align: right;"><%= result.visits %></td>
            </tr>
        <%  }); %>
    </table>
  </body>
</html>
